<Window x:Class="Synthetic.TaskPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Synthetic.Controls;assembly=Synthetic"
        x:Name="taskWindow" Title="タスク / Tasks">
  <Window.Resources>
    <ResourceDictionary>
      <Style x:Key="primaryButton" TargetType="Button">
        <Setter Property="Margin" Value="4"/>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid x:Name="grid">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="title" Grid.Row="0" Text="タスク名 🌊"/>
    <StackPanel x:Name="body" Grid.Row="1" Orientation="Vertical">
      <TextBox x:Name="taskName" TabIndex="1"
               Text="{Binding TaskName, Mode=TwoWay}"
               AutomationProperties.Name="タスク名"
               AutomationProperties.LabeledBy="{x:Reference title}"/>
      <Button x:Name="addButton" TabIndex="2" Content="Add"
              Style="{StaticResource primaryButton}"
              Click="AddButton_Click"
              Command="{Binding AddCommand}"/>
      <local:GaugeControl x:Name="gauge" Value="3"/>
    </StackPanel>
  </Grid>
</Window>

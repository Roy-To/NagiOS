# Reversible development config fragment for the selected x86_64 direct-boot target.
# Merge the active entries into the exact kernel .config and pin that resulting file.
CONFIG_X86_64=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_ELF=y
CONFIG_PRINTK=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
# CONFIG_CMDLINE_OVERRIDE is not set

# QEMU display path: support stdvga (Bochs DRM) and VirtIO GPU, with the
# legacy fbdev node required by the current Notes/Desktop development client.
CONFIG_DRM=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_VIRTIO_GPU_KMS=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FB_CORE=y
CONFIG_FB_DEVICE=y

# PROVISIONAL / UNSELECTED AArch64 profile retained as comments; do not merge/use.
# CONFIG_ARM64=y
# CONFIG_BLK_DEV_INITRD=y
# CONFIG_BINFMT_ELF=y
# CONFIG_PRINTK=y
# CONFIG_SERIAL_AMBA_PL011=y
# CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
# CONFIG_CMDLINE_OVERRIDE is not set

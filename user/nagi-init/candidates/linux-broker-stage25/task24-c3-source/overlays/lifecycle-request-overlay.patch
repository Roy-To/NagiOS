+    /// Begin cleanup for one exact child without creating a second reaper.
+    /// The pidfd proof selects the candidate slot, then the retained clone3
+    /// process-instance identity and LaunchRecord must both match. A later
+    /// `poll()` uses the existing ProcessOs termination state and Pid1ChildReaper.
+    pub(crate) fn request_cleanup_exact(
+        &mut self,
+        proof: &SpawnedProcessPidfd,
+        record: LaunchRecord,
+    ) -> Result<(), BackendError> {
+        let identity = proof.identity();
+        let process_id = proof.process_id();
+        if let Some(entry) = self.children.iter_mut().find(|entry| entry.process_id == process_id) {
+            if !self.os.same_process_instance(&entry.child, &identity) || entry.record != record {
+                return Err(BackendError::IdentityRejected);
+            }
+            if entry.cleanup_requested {
+                return Err(BackendError::ProtocolViolation);
+            }
+            // Publish one-shot ownership before the pidfd syscall. A syscall
+            // error remains an ambiguous request; later polls observe/reap but
+            // this method cannot send a second signal.
+            entry.cleanup_requested = true;
+            return self
+                .os
+                .terminate(&mut entry.child)
+                .map_err(|_| BackendError::TransportFailure);
+        }
+        if let Some(entry) = self.quarantine.iter().find(|entry| entry.process_id == process_id) {
+            let same_instance = match &entry.child {
+                PendingChild::Prepared(child) => self.os.same_process_instance(child, &identity),
+                PendingChild::ReleaseUncertain(child) => self.os.same_process_instance(child, &identity),
+                PendingChild::Running(child) => self.os.same_process_instance(child, &identity),
+            };
+            let owned_record = entry.record.or_else(|| entry.launch_lease.as_ref().map(|lease| lease.record));
+            if same_instance && owned_record == Some(record) {
+                // Shutdown already owns cleanup for this exact launch. Do not
+                // issue another termination request or create another owner.
+                return Ok(());
+            }
+        }
+        Err(BackendError::IdentityRejected)
+    }
+
